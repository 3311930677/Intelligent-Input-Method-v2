{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "displayName": "Windows x64 Debug"
    },
    {
      "name": "windows-release",
      "inherits": "windows-base",
      "displayName": "Windows x64 Release"
    },
    {
      "name": "windows-release-ort",
      "inherits": "windows-base",
      "displayName": "Windows x64 Release with ONNX Runtime",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OWO_ENABLE_ONNXRUNTIME": "ON",
        "OWO_ONNXRUNTIME_ROOT": "${sourceDir}/build/dependencies/onnxruntime-1.28.0/sdk"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "windows-release-ort",
      "configurePreset": "windows-release-ort",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release-ort",
      "configurePreset": "windows-release-ort",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
