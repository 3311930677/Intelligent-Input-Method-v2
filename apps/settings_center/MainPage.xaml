<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="OwO_Settings.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="720" Padding="32" Spacing="20" HorizontalAlignment="Left">
            <TextBlock Text="OwO 输入法设置" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="更改会原子保存，并由 Core Service 自动热加载。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid ColumnSpacing="24" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="每页候选数" VerticalAlignment="Center" />
                <NumberBox x:Name="CandidatePageSize" Grid.Row="0" Grid.Column="1"
                           Minimum="1" Maximum="9" SpinButtonPlacementMode="Inline" />
                <TextBlock Grid.Row="1" Text="用户词频学习" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="UserLearning" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="2" Text="智能模型排序" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="ModelRanking" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="3" Text="模型预算（毫秒）" VerticalAlignment="Center" />
                <NumberBox x:Name="ModelTimeout" Grid.Row="3" Grid.Column="1"
                           Minimum="5" Maximum="500" SpinButtonPlacementMode="Inline" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SaveButton" Content="保存" Click="SaveButton_Click" />
                <Button Content="重新加载" Click="ReloadButton_Click" />
            </StackPanel>
            <InfoBar x:Name="Status" IsOpen="True" Severity="Informational"
                     Title="正在加载配置" IsClosable="False" />
            <TextBlock x:Name="ConfigPath" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
