<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="OwO_Settings.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="720" Padding="32" Spacing="20" HorizontalAlignment="Left">
            <TextBlock Text="OwO 输入法设置" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="更改会原子保存，并由 Core Service 自动热加载。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid ColumnSpacing="24" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="每页候选数" VerticalAlignment="Center" />
                <NumberBox x:Name="CandidatePageSize" Grid.Row="0" Grid.Column="1"
                           Minimum="1" Maximum="9" SpinButtonPlacementMode="Inline" />
                <TextBlock Grid.Row="1" Text="用户词频学习" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="UserLearning" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="2" Text="智能模型排序" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="ModelRanking" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="3" Text="模型预算（毫秒）" VerticalAlignment="Center" />
                <NumberBox x:Name="ModelTimeout" Grid.Row="3" Grid.Column="1"
                           Minimum="5" Maximum="500" SpinButtonPlacementMode="Inline" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SaveButton" Content="保存" Click="SaveButton_Click" />
                <Button Content="重新加载" Click="ReloadButton_Click" />
            </StackPanel>
            <InfoBar x:Name="Status" IsOpen="True" Severity="Informational"
                     Title="正在加载配置" IsClosable="False" />
            <TextBlock x:Name="ConfigPath" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <ContentControl x:Name="PluginSection" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="14">
                <TextBlock Text="插件管理" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="只安装通过 Windows 发布者信任验证的签名包；不提供未签名开发模式。插件停用后，版本、授权和用户数据会保留。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="PluginInstallButton" Content="安装签名插件包…"
                            Click="PluginInstallButton_Click" />
                    <Button x:Name="PluginReloadButton" Content="刷新插件状态"
                            Click="PluginReloadButton_Click" />
                </StackPanel>
                <TextBlock x:Name="NoPlugins" Text="尚未安装有效插件版本。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="PluginVersions">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding ActionLabel}" Tag="{Binding}"
                                            Click="PluginVersionAction_Click" />
                                    <Button Content="卸载此版本" Tag="{Binding}"
                                            IsEnabled="{Binding CanUninstall}"
                                            Click="PluginVersionUninstall_Click" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="恢复与维护" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock x:Name="NoRecovery" Text="未发现需要审计的恢复项。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="RecoveryItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ActionLabel}" Tag="{Binding}"
                                        IsEnabled="{Binding CanApply}" Click="RecoveryAction_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="PluginPath" FontFamily="Consolas" FontSize="12"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
